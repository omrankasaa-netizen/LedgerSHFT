# PostgreSQL connection string (Railway provides this as DATABASE_URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgershift"

# HTTP server
PORT=4000
# Comma-separated list of allowed frontend origins, or * for local dev
CORS_ORIGIN="*"

# JWT auth — always set a long random secret in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# First admin account, created by `npm run seed` (change the password!)
ADMIN_EMAIL="admin@ledgershift.local"
ADMIN_PASSWORD="admin12345"

# Invoice parsing provider for POST /api/purchase-invoices/parse-upload.
# "mock" returns sample data. Plug in Azure Document Intelligence / Google
# Document AI later by adding a provider next to services/invoiceParsing/.
INVOICE_PARSER_PROVIDER="mock"
