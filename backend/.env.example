# PostgreSQL connection string (Railway provides this as DATABASE_URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgershift"

# HTTP server
PORT=4000
# Comma-separated list of allowed frontend origins, or * for local dev
CORS_ORIGIN="*"

# JWT auth — always set a long random secret in production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# First admin account, created by `npm run seed` (change the password!)
ADMIN_EMAIL="admin@ledgershift.local"
ADMIN_PASSWORD="admin12345"

# Invoice parsing provider for POST /api/purchase-invoices/parse-upload.
# "mock" returns sample data; "azure", "mindee" or "docuparse" call the real APIs.
INVOICE_PARSER_PROVIDER="mock"

# Azure Document Intelligence — required when INVOICE_PARSER_PROVIDER=azure
# (from Azure portal → your Document Intelligence resource → Keys and Endpoint)
AZURE_DOC_INTEL_KEY=""
AZURE_DOC_INTEL_ENDPOINT="https://<resource>.cognitiveservices.azure.com"

# Mindee (https://www.mindee.com) — required when INVOICE_PARSER_PROVIDER=mindee
MINDEE_API_KEY=""
MINDEE_BASE_URL="https://api.mindee.net"

# DocuParse (https://docuparseapi.com) — required when INVOICE_PARSER_PROVIDER=docuparse
DOCUPARSE_API_KEY=""
DOCUPARSE_BASE_URL="https://docuparseapi.com"
DOCUPARSE_TIMEOUT_MS="60000"
