{
  "name": "Payment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "relation": "Customer",
      "required": true,
      "title": "Customer"
    },
    "invoice_id": {
      "type": "string",
      "relation": "Invoice",
      "title": "Invoice"
    },
    "date": {
      "type": "string",
      "format": "date",
      "required": true,
      "title": "Date"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "LBP"
      ],
      "default": "USD",
      "title": "Currency"
    },
    "amount": {
      "type": "number",
      "required": true,
      "default": 0,
      "title": "Amount"
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "cheque",
        "remittance",
        "other"
      ],
      "default": "cash",
      "title": "Method"
    },
    "reference": {
      "type": "string",
      "title": "Reference"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "customer_id",
    "date",
    "amount"
  ]
}