{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "required": true,
      "title": "Name"
    },
    "role": {
      "type": "string",
      "enum": [
        "investor",
        "co-owner",
        "supplier",
        "other"
      ],
      "default": "investor",
      "title": "Role"
    },
    "contact": {
      "type": "string",
      "title": "Contact"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "default_share_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_amount",
        "none"
      ],
      "default": "none",
      "title": "Default Share Type"
    },
    "default_share_value": {
      "type": "number",
      "default": 0,
      "title": "Default Share Value"
    }
  },
  "required": [
    "name"
  ]
}