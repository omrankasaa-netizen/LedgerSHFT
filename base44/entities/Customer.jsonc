{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "required": true,
      "title": "Name"
    },
    "type": {
      "type": "string",
      "enum": [
        "shop",
        "pharmacy",
        "supermarket",
        "restaurant",
        "other"
      ],
      "default": "shop",
      "title": "Type"
    },
    "contact_person": {
      "type": "string",
      "title": "Contact Person"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name"
  ]
}